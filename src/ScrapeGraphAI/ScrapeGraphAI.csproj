    <PackageId>ScrapeGraphAI.Client</PackageId>
    <Description>.NET 10 SDK for ScrapeGraphAI v2 with typed HttpClient and resilience.</Description>
    <PackageTags>scrapegraphai;scraping;web-scraping;ai</PackageTags>
